  (g : Fin 4 → MvPowerSeries σ ℝ) (hQ : Q.map ⇑MvPowerSeries.constantCoeff = MUBLocalGermAlgebra.mixedMatrix √3) :
  Ideal.span (Set.range (Q.mulVec g)) = Ideal.span (Set.range g)
@[expose] def MUBLocalGermAlgebra.mixedMatrix : ℝ → Matrix (Fin 4) (Fin 4) ℝ :=
fun r =>
  !![1, -r / 3, -1, r / 3;
    1, -r / 3, 1 + r, 2 * r / 3;
    1, -1 + 2 * r / 3, 0, 0;
    1, -1 + 2 * r / 3, -2 + r, -1 + 2 * r / 3]
MUBCoordinateProductIdeal.actual_cross_intersection.{u_2} {R : Type u_2} [CommRing R] :
  MUBCoordinateProductIdeal.crossIdeal = MUBCoordinateProductIdeal.leftPlane ⊓ MUBCoordinateProductIdeal.rightPlane
MUBCoordinateProductIdeal.actual_cross_quotient_reduced.{u_2} {R : Type u_2} [CommRing R] [IsDomain R] :
  IsReduced (MUBCoordinateProductIdeal.FourPoly R ⧸ MUBCoordinateProductIdeal.crossIdeal)
@[expose] def MUBCoordinateProductIdeal.crossIdeal.{u_2} : {R : Type u_2} →
  [inst : CommRing R] → Ideal (MUBCoordinateProductIdeal.FourPoly R) :=
fun {R} [CommRing R] =>
  Ideal.span
    {MvPolynomial.X 0 * MvPolynomial.X 2, MvPolynomial.X 0 * MvPolynomial.X 3, MvPolynomial.X 1 * MvPolynomial.X 2,
      MvPolynomial.X 1 * MvPolynomial.X 3}
MUBMixedTransport.mixed_projector_factorization.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (A B : Matrix n n ℂ) :
  have V := MUBTensorFrame.repetition n;
  have F := MUBQuantumTransport.repeatedFrame A;
  have G := MUBQuantumTransport.repeatedFrame B;
  V * V.conjTranspose * (F * F.conjTranspose) * (G * G.conjTranspose) =
    V * (MUBQuantumTransport.cube A * MUBQuantumTransport.cube (A.conjTranspose * B)) * G.conjTranspose
MUBMixedTransport.centered_mixed_norm.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (A B : Matrix n n ℂ)
  (hunit : B ∈ Matrix.unitaryGroup n ℂ) (hflat : ∀ (i j : n), Complex.normSq (B i j) = 1 / 6) :
  have D := MUBMixedTransport.mixedOperator A B - (1 / 36) • 1;
  have R := MUBQuantumTransport.cube A * MUBQuantumTransport.cube (A.conjTranspose * B) - MUBQuantumTransport.cube B;
  (D.conjTranspose * D).trace = (R.conjTranspose * R).trace / 36
@[expose] def MUBMixedTransport.mixedOperator.{u_1} : {n : Type u_1} →
  [Fintype n] → [DecidableEq n] → Matrix n n ℂ → Matrix n n ℂ → Matrix n n ℂ :=
fun {n} [Fintype n] [DecidableEq n] A B =>
  have V := MUBTensorFrame.repetition n;
  have F := MUBQuantumTransport.repeatedFrame A;
  have G := MUBQuantumTransport.repeatedFrame B;
  MUBQuantumTransport.partialTrace12 (V * V.conjTranspose * (F * F.conjTranspose) * (G * G.conjTranspose))
MUBBalancedSmallTables.actual_moment_majorant_bound (g : MUBBalancedSmallTables.Graph)
  (e : MUBBalancedSmallTables.SignChoice) (h : 0 < MUBBalancedSmallTables.schur g e) :
  MUBBalancedSmallTables.momentMajorant g e √3 < ↑(MUBBalancedSmallTables.tableBound g) ∧
    MUBBalancedSmallTables.momentMajorant g e √3 < 25 / 2
MUBBalancedSmallTables.sqrt_sum_lt_of_actual_moments (g : MUBBalancedSmallTables.Graph)
  (e : MUBBalancedSmallTables.SignChoice) (h : 0 < MUBBalancedSmallTables.schur g e) (x : Fin 5 → ℝ)
  (hx : ∀ (i : Fin 5), 0 ≤ x i) (h1 : ∑ i, x i = ↑(MUBBalancedSmallTables.moment g e 1))
  (h2 : ∑ i, x i ^ 2 = ↑(MUBBalancedSmallTables.moment g e 2))
  (h3 : ∑ i, x i ^ 3 = ↑(MUBBalancedSmallTables.moment g e 3)) : ∑ i, √(x i) < 25 / 2
@[expose] def MUBBalancedSmallTables.moment : MUBBalancedSmallTables.Graph →
  MUBBalancedSmallTables.SignChoice → ℕ → ℚ :=
fun g e k => ((MUBBalancedSmallTables.extension g e * MUBBalancedSmallTables.centeringWeight) ^ k).trace
@[expose] def MUBBalancedSmallTables.extension : MUBBalancedSmallTables.Graph →
  MUBBalancedSmallTables.SignChoice → Matrix (Fin 5) (Fin 5) ℚ :=
fun g e i j =>
  if i = 0 then if j = 0 then 6 else 2 * MUBBalancedSmallTables.epsilon e (MUBBalancedSmallTables.tailIndex j)
  else
    if j = 0 then 2 * MUBBalancedSmallTables.epsilon e (MUBBalancedSmallTables.tailIndex i)
    else MUBBalancedSmallTables.graphGram g (MUBBalancedSmallTables.tailIndex i) (MUBBalancedSmallTables.tailIndex j)
@[expose] def MUBBalancedSmallTables.centeringWeight : Matrix (Fin 5) (Fin 5) ℚ :=
fun i j => (if i = j then if i = 0 then 2 else 1 else 0) - if i = 0 ∨ j = 0 then 0 else 1 / 6
@[expose] def MUBBalancedSmallTables.schur : MUBBalancedSmallTables.Graph → MUBBalancedSmallTables.SignChoice → ℚ :=
fun g e =>
  6 -
    4 *
      ∑ i,
        ∑ j,
          MUBBalancedSmallTables.epsilon e i * MUBBalancedSmallTables.graphInverse g i j *
            MUBBalancedSmallTables.epsilon e j
MUBFourLineForms.eight_gram_characteristic_polynomials (e : MUBFourLineForms.Signs) :
