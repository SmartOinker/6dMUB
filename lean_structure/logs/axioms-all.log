MUBCompatibility.coupled_equations_unitary.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (A B C : Matrix n n ℂ)
  (hAC : A * C = B) (hAB : A.conjTranspose * B = C) (hBC : B * C.conjTranspose = A)
  (htrace : (A.conjTranspose * A).trace = ↑(Fintype.card n)) :
  A ∈ Matrix.unitaryGroup n ℂ ∧ B ∈ Matrix.unitaryGroup n ℂ ∧ C ∈ Matrix.unitaryGroup n ℂ
MUBCompatibility.coupled_flat_unitary.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] [Nonempty n]
  (A B C : Matrix n n ℂ) (hAC : A * C = B) (hAB : A.conjTranspose * B = C) (hBC : B * C.conjTranspose = A)
  (hflat : ∀ (i j : n), Complex.normSq (A i j) = (↑(Fintype.card n))⁻¹) :
  A ∈ Matrix.unitaryGroup n ℂ ∧ B ∈ Matrix.unitaryGroup n ℂ ∧ C ∈ Matrix.unitaryGroup n ℂ
MUBPhaseTensorConverse.phase_tensor_equivalence (t : MUBPhaseTensor.Tensor MUBPhaseTensor.Six) :
  MUBPhaseTensor.UnitTensor t ∧ MUBPhaseTensor.AnchoredBoxes t 0 ∧ MUBPhaseTensor.LineSums t MUBPhaseTensor.rootSix ↔
    ∃ A B C, MUBPhaseTensor.PhysicalRealization t A B C
@[expose] def MUBPhaseTensor.UnitTensor.{u_1} : {n : Type u_1} → MUBPhaseTensor.Tensor n → Prop :=
fun {n} t => ∀ (i k j : n), t i k j * (starRingEnd ℂ) (t i k j) = 1
@[expose] def MUBPhaseTensor.AnchoredBoxes.{u_1} : {n : Type u_1} → MUBPhaseTensor.Tensor n → n → Prop :=
fun {n} t o =>
  ∀ (i k j : n), i ≠ o → k ≠ o → j ≠ o → t i k j * t i o o * t o k o * t o o j = t i k o * t i o j * t o k j * t o o o
@[expose] def MUBPhaseTensor.LineSums.{u_1} : {n : Type u_1} → [Fintype n] → MUBPhaseTensor.Tensor n → ℂ → Prop :=
fun {n} [Fintype n] t s =>
  (∀ (i j : n), ∑ k, t i k j = s) ∧ (∀ (k j : n), ∑ i, t i k j = s) ∧ ∀ (i k : n), ∑ j, t i k j = s
@[expose] def MUBPhaseTensor.PhysicalRealization : MUBPhaseTensor.Tensor MUBPhaseTensor.Six →
  Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ →
    Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ → Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ → Prop :=
fun t A B C =>
  A ∈ Matrix.unitaryGroup MUBPhaseTensor.Six ℂ ∧
    B ∈ Matrix.unitaryGroup MUBPhaseTensor.Six ℂ ∧
      C ∈ Matrix.unitaryGroup MUBPhaseTensor.Six ℂ ∧
        A * C = B ∧
          (∀ (i j : MUBPhaseTensor.Six), Complex.normSq (A i j) = 1 / 6) ∧
            (∀ (i j : MUBPhaseTensor.Six), Complex.normSq (B i j) = 1 / 6) ∧
              (∀ (i j : MUBPhaseTensor.Six), Complex.normSq (C i j) = 1 / 6) ∧
                ∀ (i k j : MUBPhaseTensor.Six), t i k j = MUBPhaseTensor.rootSix * A i k * C k j / B i j
MUBResidualBounds.residual_purity_lower_bound.{u_1} {n : Type u_1} [Fintype n] (M : Matrix n n ℂ)
  (ht : (M.conjTranspose * M).trace = 36) : MUBPurityGap.purityGap M ^ 2 / 36 ≤ MUBResidualBounds.residualEnergy M
MUBResidualBounds.residual_purity_upper_bound.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (M : Matrix n n ℂ)
  (hcap : (18 • 1 - M.conjTranspose * M).PosSemidef) (ht : (M.conjTranspose * M).trace = 36) :
  MUBResidualBounds.residualEnergy M ≤ 18 * MUBPurityGap.purityGap M
MUBQuantumTransport.physical_partial_trace.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (U : Matrix n n ℂ) :
  MUBQuantumTransport.overlapSquare U =
    MUBQuantumTransport.transport U
      (MUBQuantumTransport.cube U * (MUBQuantumTransport.cube U).conjTranspose * MUBQuantumTransport.cube U)
MUBQuantumTransport.residual_energy_decomposition (U : Matrix (Fin 6) (Fin 6) ℂ)
  (hunit : U ∈ Matrix.unitaryGroup (Fin 6) ℂ) (hflat : ∀ (i j : Fin 6), Complex.normSq (U i j) = 1 / 6) :
  ((MUBQuantumTransport.normalizedResidual U).conjTranspose * MUBQuantumTransport.normalizedResidual U).trace =
    5184 * ((MUBQuantumTransport.tracelessOverlap U).conjTranspose * MUBQuantumTransport.tracelessOverlap U).trace +
      864 * MUBQuantumTransport.normalizedGap U ^ 2
@[expose] def MUBQuantumTransport.transport.{u_1} : {n : Type u_1} →
  [Fintype n] → Matrix n n ℂ → Matrix n n ℂ → Matrix n n ℂ :=
fun {n} [Fintype n] U R => (Matrix.of fun i j => R i j * star (U i j ^ 2)) * U.conjTranspose
@[expose] def MUBQuantumTransport.partialTrace12.{u_1} : {n : Type u_1} →
  [Fintype n] → Matrix (MUBTensorFrame.Triple n) (MUBTensorFrame.Triple n) ℂ → Matrix n n ℂ :=
fun {n} [Fintype n] Q i j => ∑ a, ∑ b, Q (a, b, i) (a, b, j)
@[expose] def MUBQuantumTransport.overlapSquare.{u_1} : {n : Type u_1} →
  [Fintype n] → [DecidableEq n] → Matrix n n ℂ → Matrix n n ℂ :=
fun {n} [Fintype n] [DecidableEq n] U =>
  have P₀ := MUBTensorFrame.repetition n * (MUBTensorFrame.repetition n).conjTranspose;
  have Pᵤ := MUBQuantumTransport.repeatedFrame U * (MUBQuantumTransport.repeatedFrame U).conjTranspose;
  MUBQuantumTransport.partialTrace12 (P₀ * Pᵤ * (P₀ * Pᵤ))
@[expose] def MUBQuantumTransport.normalizedResidual.{u_1} : {n : Type u_1} →
  [Fintype n] → Matrix n n ℂ → Matrix n n ℂ :=
fun {n} [Fintype n] U =>
  12 • (MUBQuantumTransport.cube U * (MUBQuantumTransport.cube U).conjTranspose * MUBQuantumTransport.cube U) -
    MUBQuantumTransport.cube U
@[expose] def MUBQuantumTransport.normalizedGap : Matrix (Fin 6) (Fin 6) ℂ → ℂ :=
fun U =>
  1 / 72 -
    ((MUBQuantumTransport.cube U).conjTranspose * MUBQuantumTransport.cube U *
        ((MUBQuantumTransport.cube U).conjTranspose * MUBQuantumTransport.cube U)).trace
@[expose] def MUBQuantumTransport.tracelessOverlap : Matrix (Fin 6) (Fin 6) ℂ → Matrix (Fin 6) (Fin 6) ℂ :=
fun U => MUBQuantumTransport.overlapSquare U - (1 / 432 - MUBQuantumTransport.normalizedGap U / 6) • 1
MUBAnchoredPurity.anchored_square_identity.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (R : Matrix n n ℂ)
  (hR : R.IsHermitian) (hpurity : (R * R).trace = 1) (a : n) :
  have Z := MUBAnchoredPurity.anchorMass R a • R - MUBAnchoredPurity.anchorOuter R a;
  (Z.conjTranspose * Z).trace = 2 * MUBAnchoredPurity.anchorMass R a * MUBAnchoredPurity.anchorDefect R a
MUBAnchoredPurity.anchored_distance_identity.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (R : Matrix n n ℂ)
  (hR : R.IsHermitian) (hpurity : (R * R).trace = 1) (a : n) (ha : R a a ≠ 0) :
  ((R - MUBAnchoredPurity.anchorProjection R a).conjTranspose * (R - MUBAnchoredPurity.anchorProjection R a)).trace =
    2 * MUBAnchoredPurity.anchorDefect R a / MUBAnchoredPurity.anchorMass R a
MUBAnchoredPurity.anchored_defect_zero_iff.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (R : Matrix n n ℂ)
  (hR : R.IsHermitian) (hpurity : (R * R).trace = 1) (a : n) (ha : R a a ≠ 0) :
  MUBAnchoredPurity.anchorDefect R a = 0 ↔ R.PosSemidef ∧ R * R = R ∧ R.rank = 1
MUBAnchoredPurity.anchored_distance_weighted_bound.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (R : Matrix n n ℂ)
  (hR : R.IsHermitian) (hpurity : (R * R).trace = 1) (a : n) (ha : R a a ≠ 0) :
  ((R - MUBAnchoredPurity.anchorProjection R a).conjTranspose * (R - MUBAnchoredPurity.anchorProjection R a)).trace *
      ↑(Complex.normSq (R a a)) ≤
    2 * MUBAnchoredPurity.anchorDefect R a
MUBAnchoredPurity.anchored_minor_identity.{u_1} {n : Type u_1} [Fintype n] (R : Matrix n n ℂ) (a : n) :
  MUBAnchoredPurity.anchoredMinorSum R a =
    (R * R * R) a a - R.trace * (R * R) a a + (R.trace ^ 2 - (R * R).trace) / 2 * R a a
MUBAnchoredPurity.aggregate_minor_nonnegative_iff.{u_1, u_2} {n : Type u_1} [Fintype n] [DecidableEq n] {b : Type u_2}
  [Fintype b] (R : b → Matrix n n ℂ) (a : n) (hHermitian : ∀ (k : b), (R k).IsHermitian)
  (htrace : ∀ (k : b), (R k).trace = 1) (hpurity : ∀ (k : b), (R k * R k).trace = 1)
  (hanchor : ∀ (k : b), R k a a ≠ 0) :
  0 ≤ ∑ k, MUBAnchoredPurity.anchoredMinorSum (R k) a ↔ ∀ (k : b), (R k).PosSemidef ∧ R k * R k = R k ∧ (R k).rank = 1
@[expose] def MUBAnchoredPurity.anchorDefect.{u_1} : {n : Type u_1} → [Fintype n] → Matrix n n ℂ → n → ℂ :=
fun {n} [Fintype n] R a => (R * R - R * R * R) a a
@[expose] def MUBAnchoredPurity.anchorProjection.{u_1} : {n : Type u_1} →
  [Fintype n] → Matrix n n ℂ → n → Matrix n n ℂ :=
fun {n} [Fintype n] R a => (MUBAnchoredPurity.anchorMass R a)⁻¹ • MUBAnchoredPurity.anchorOuter R a
@[expose] def MUBAnchoredPurity.anchoredMinorSum.{u_1} : {n : Type u_1} → [Fintype n] → Matrix n n ℂ → n → ℂ :=
fun {n} [Fintype n] R a => 1 / 2 * ∑ i, ∑ j, (R.submatrix ![a, i, j] ![a, i, j]).det
MUBSixPhasePolynomial.positive_polynomial_certificate (t : ℝ) (ht : 0 ≤ t) :
  0 < MUBSixPhasePolynomial.polynomialP (1 + t) ∧ 0 < MUBSixPhasePolynomial.polynomialQ (1 + t)
MUBSixPhasePolynomial.rational_gap_identities (L : ℝ) (hL : L ≠ 0) :
  MUBSixPhasePolynomial.targetGap L = (9 - L) * MUBSixPhasePolynomial.polynomialP L / (72 * L ^ 3) ∧
    MUBSixPhasePolynomial.targetGap L ^ 2 - MUBSixPhasePolynomial.envelopeVariance L =
      5 * (L - 9) ^ 2 * MUBSixPhasePolynomial.polynomialQ L / (648 * L ^ 3)
MUBSixPhasePolynomial.sharp_envelope_bound (L : ℝ) (hlo : 1 ≤ L) (hhi : L ≤ 9) :
  MUBSixPhasePolynomial.envelopeCenter L + √(MUBSixPhasePolynomial.envelopeVariance L) ≤ 98 / 3 ∧
    (MUBSixPhasePolynomial.envelopeCenter L + √(MUBSixPhasePolynomial.envelopeVariance L) = 98 / 3 ↔ L = 9)
@[expose] def MUBSixPhasePolynomial.polynomialP : ℝ → ℝ :=
fun L => 13 * L ^ 5 - 12 * L ^ 4 + 243 * L ^ 3 - 705 * L ^ 2 + 864 * L - 243
@[expose] def MUBSixPhasePolynomial.polynomialQ : ℝ → ℝ :=
fun L => 4 * L ^ 7 + 3 * L ^ 6 + 9 * L ^ 5 + 435 * L ^ 4 - 2142 * L ^ 3 + 4293 * L ^ 2 - 4311 * L + 2349
@[expose] def MUBSixPhasePolynomial.envelopeCenter : ℝ → ℝ :=
fun L => (13 * L ^ 6 - 129 * L ^ 5 + 351 * L ^ 4 - 540 * L ^ 3 + 7209 * L ^ 2 - 8019 * L + 2187) / (72 * L ^ 3)
@[expose] def MUBSixPhasePolynomial.envelopeVariance : ℝ → ℝ :=
fun L => (L - 9) ^ 3 * (L - 1) ^ 3 * (L ^ 2 - 30 * L + 9) * (L ^ 2 - 3 * L + 9) ^ 2 / (576 * L ^ 6)
@[expose] def MUBSixPhasePolynomial.targetGap : ℝ → ℝ :=
fun L => 98 / 3 - MUBSixPhasePolynomial.envelopeCenter L
MUBTetrahedral.tetrahedral_equivalence (t u v w : MUBPhaseTensor.Tensor MUBPhaseTensor.Six) :
  MUBTetrahedral.TetrahedralConditions t u v w ↔ ∃ A B D C E F, MUBTetrahedral.PhysicalQuartet t u v w A B D C E F
MUBTetrahedral.physical_quartet_is_unbiased (t u v w : MUBPhaseTensor.Tensor MUBPhaseTensor.Six)
  (A B D C E F : Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ)
  (h : MUBTetrahedral.PhysicalQuartet t u v w A B D C E F) : MUBTetrahedral.UnbiasedQuartet A B D
MUBTetrahedral.fourth_face_conditions (t u v w : MUBPhaseTensor.Tensor MUBPhaseTensor.Six)
  (h : MUBTetrahedral.TetrahedralConditions t u v w) :
  MUBPhaseTensor.UnitTensor w ∧ MUBPhaseTensor.AnchoredBoxes w 0 ∧ MUBPhaseTensor.LineSums w MUBPhaseTensor.rootSix
@[expose] def MUBTetrahedral.Cocycle.{u_1} : {n : Type u_1} →
  MUBPhaseTensor.Tensor n → MUBPhaseTensor.Tensor n → MUBPhaseTensor.Tensor n → MUBPhaseTensor.Tensor n → Prop :=
fun {n} t u v w => ∀ (a b c d : n), t a b c * v a c d = u a b d * w b c d
@[expose] def MUBTetrahedral.TetrahedralConditions : MUBPhaseTensor.Tensor MUBPhaseTensor.Six →
  MUBPhaseTensor.Tensor MUBPhaseTensor.Six →
    MUBPhaseTensor.Tensor MUBPhaseTensor.Six → MUBPhaseTensor.Tensor MUBPhaseTensor.Six → Prop :=
fun t u v w =>
  MUBPhaseTensor.UnitTensor t ∧
    MUBPhaseTensor.UnitTensor u ∧
      MUBPhaseTensor.UnitTensor v ∧
        MUBPhaseTensor.UnitTensor w ∧
          MUBTetrahedral.Cocycle t u v w ∧
            MUBPhaseTensor.LineSums t MUBPhaseTensor.rootSix ∧
              MUBPhaseTensor.LineSums u MUBPhaseTensor.rootSix ∧ MUBPhaseTensor.LineSums v MUBPhaseTensor.rootSix
@[expose] def MUBTetrahedral.PhysicalQuartet : MUBPhaseTensor.Tensor MUBPhaseTensor.Six →
  MUBPhaseTensor.Tensor MUBPhaseTensor.Six →
    MUBPhaseTensor.Tensor MUBPhaseTensor.Six →
      MUBPhaseTensor.Tensor MUBPhaseTensor.Six →
        Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ →
          Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ →
            Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ →
              Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ →
                Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ →
                  Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ → Prop :=
fun t u v w A B D C E F =>
  MUBPhaseTensor.PhysicalRealization t A B C ∧
    MUBPhaseTensor.PhysicalRealization u A D E ∧
      MUBPhaseTensor.PhysicalRealization v B D F ∧ MUBPhaseTensor.PhysicalRealization w C E F
@[expose] def MUBTetrahedral.UnbiasedQuartet : Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ →
  Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ → Matrix MUBPhaseTensor.Six MUBPhaseTensor.Six ℂ → Prop :=
fun A B D =>
  A ∈ Matrix.unitaryGroup MUBPhaseTensor.Six ℂ ∧
    B ∈ Matrix.unitaryGroup MUBPhaseTensor.Six ℂ ∧
      D ∈ Matrix.unitaryGroup MUBPhaseTensor.Six ℂ ∧
        (∀ (i j : MUBPhaseTensor.Six), Complex.normSq (A i j) = 1 / 6) ∧
          (∀ (i j : MUBPhaseTensor.Six), Complex.normSq (B i j) = 1 / 6) ∧
            (∀ (i j : MUBPhaseTensor.Six), Complex.normSq (D i j) = 1 / 6) ∧
              (∀ (i j : MUBPhaseTensor.Six), Complex.normSq ((A.conjTranspose * B) i j) = 1 / 6) ∧
                (∀ (i j : MUBPhaseTensor.Six), Complex.normSq ((A.conjTranspose * D) i j) = 1 / 6) ∧
                  ∀ (i j : MUBPhaseTensor.Six), Complex.normSq ((B.conjTranspose * D) i j) = 1 / 6
MUBLocalExhaustion.local_graph_exhaustion.{u_1, u_2, u_3, u_4} {E : Type u_1} {Y : Type u_2} {W : Type u_3}
  {Z : Type u_4} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] [NormedAddCommGroup Y] [NormedSpace ℝ Y]
  [CompleteSpace Y] [NormedAddCommGroup W] [NormedSpace ℝ W] [CompleteSpace W] [Zero Z] (F : E × Y → Z) (G : E × Y → W)
  (u : E × Y) (G' : E × Y →L[ℝ] W) (seed : E → Y) (hG : HasStrictFDerivAt G G' u)
  (hinv : (G' ∘SL ContinuousLinearMap.inr ℝ E Y).IsInvertible) (hzero : G u = 0)
  (hselect : ∀ (p : E × Y), F p = 0 → G p = 0) (hseed_cont : ContinuousAt seed u.1) (hseed_anchor : seed u.1 = u.2)
  (hseed_full : ∀ᶠ (q : E) in nhds u.1, F (q, seed q) = 0) : ∀ᶠ (p : E × Y) in nhds u, F p = 0 ↔ p.2 = seed p.1
MUBLocalExhaustion.local_property_transfer.{u_1, u_2, u_3, u_4} {E : Type u_1} {Y : Type u_2} {W : Type u_3}
  {Z : Type u_4} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E] [NormedAddCommGroup Y] [NormedSpace ℝ Y]
  [CompleteSpace Y] [NormedAddCommGroup W] [NormedSpace ℝ W] [CompleteSpace W] [Zero Z] (F : E × Y → Z) (G : E × Y → W)
  (u : E × Y) (G' : E × Y →L[ℝ] W) (seed : E → Y) (P : E × Y → Prop) (hG : HasStrictFDerivAt G G' u)
  (hinv : (G' ∘SL ContinuousLinearMap.inr ℝ E Y).IsInvertible) (hzero : G u = 0)
  (hselect : ∀ (p : E × Y), F p = 0 → G p = 0) (hseed_cont : ContinuousAt seed u.1) (hseed_anchor : seed u.1 = u.2)
  (hseed_full : ∀ᶠ (q : E) in nhds u.1, F (q, seed q) = 0) (hseed_property : ∀ᶠ (q : E) in nhds u.1, P (q, seed q)) :
  ∀ᶠ (p : E × Y) in nhds u, F p = 0 → P p
