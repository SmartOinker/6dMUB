 Classical.choice,
 Quot.sound]
MUBNormalizerObstructions.actual_shared_chirp_obstruction (w : MUBSunCubeGram.Triple)
  (hw : MUBSunCubeGram.UnitTriple w) :
  ¬∀ (j : Fin 3), Complex.normSq (MUBNormalizerObstructions.fourier3 (fun k => 1 + w k) j) = 6
MUBNormalizerObstructions.actual_qubit_three_ray_obstruction (V : Matrix (Fin 2) (Fin 3) ℂ)
  (hunit : ∀ (a : Fin 3), ∑ i, Complex.normSq (V i a) = 1)
  (hcross : ∀ (a b : Fin 3), a ≠ b → Complex.normSq (MUBNormalizerObstructions.qubitGram V a b) = 1 / 6) : False
MUBNormalizerObstructions.actual_fourier_parseval (x : MUBSunCubeGram.Triple) :
  ∑ j, Complex.normSq (MUBNormalizerObstructions.fourier3 x j) = 3 * ∑ j, Complex.normSq (x j)
MUBNormalizerObstructions.actual_qubit_welch_identity (V : Matrix (Fin 2) (Fin 3) ℂ) :
  ∑ i, ∑ j, Complex.normSq (MUBNormalizerObstructions.qubitFrame V i j - if i = j then 3 / 2 else 0) =
    ∑ a, ∑ b, Complex.normSq (MUBNormalizerObstructions.qubitGram V a b) - 3 * ∑ a, ∑ i, Complex.normSq (V i a) + 9 / 2
@[expose] def MUBNormalizerObstructions.fourier3 : MUBSunCubeGram.Triple → MUBSunCubeGram.Triple :=
fun x =>
  ![x 0 + x 1 + x 2,
    x 0 + MUBNormalizerObstructions.omega * x 1 + (starRingEnd ℂ) MUBNormalizerObstructions.omega * x 2,
    x 0 + (starRingEnd ℂ) MUBNormalizerObstructions.omega * x 1 + MUBNormalizerObstructions.omega * x 2]
@[expose] def MUBNormalizerObstructions.qubitGram : Matrix (Fin 2) (Fin 3) ℂ → Matrix (Fin 3) (Fin 3) ℂ :=
fun V a b => ∑ i, (starRingEnd ℂ) (V i a) * V i b
@[expose] def MUBNormalizerObstructions.qubitFrame : Matrix (Fin 2) (Fin 3) ℂ → Matrix (Fin 2) (Fin 2) ℂ :=
fun V i j => ∑ a, V i a * (starRingEnd ℂ) (V j a)
MUBSeedDifferential.actual_seed_strict_submersion (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  MUBSeedDifferential.seedEquation u v 0 = 0 ∧
    HasStrictFDerivAt (MUBSeedDifferential.seedEquation u v) (MUBSeedDifferential.seedDifferential u v) 0 ∧
      Function.Surjective ⇑(MUBSeedDifferential.seedDifferential u v)
MUBSeedDifferential.actual_seed_zero_iff_varied_block_unitary (u v : MUBSunCubeGram.Triple)
  (hu : MUBSunCubeGram.UnitTriple u) (hv : MUBSunCubeGram.UnitTriple v) (theta : ↥MUBSeedDifferential.angleDomain) :
  MUBSeedDifferential.seedEquation u v theta = 0 ↔
    have a := MUBSeedDifferential.variedTriple u ![↑theta 0, ↑theta 1, ↑theta 2];
    have b := MUBSeedDifferential.variedTriple v ![↑theta 3, ↑theta 4, ↑theta 5];
    Matrix.conjTranspose (MUBSunCubeGram.blockMatrix a b) * MUBSunCubeGram.blockMatrix a b = 6 • 1
@[expose] def MUBSeedDifferential.seedEquation : MUBSunCubeGram.Triple →
  MUBSunCubeGram.Triple → ↥MUBSeedDifferential.angleDomain → ℂ :=
fun u v theta => MUBSeedDifferential.rawSeedEquation u v ↑theta
@[expose] def MUBSeedDifferential.angleDomain : Submodule ℝ MUBSeedDifferential.AngleSpace :=
{ carrier := {theta | MUBUniformSubmersion.MeanZeroPair theta}, add_mem' := @MUBSeedDifferential.angleDomain._proof_1,
  zero_mem' := MUBSeedDifferential.angleDomain._proof_3, smul_mem' := MUBSeedDifferential.angleDomain._proof_4 }
MUBSeedLocalChart.angle_domain_finrank : Module.finrank ℝ ↥MUBSeedDifferential.angleDomain = 4
MUBSeedLocalChart.actual_kernel_finrank (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  Module.finrank ℝ ↥(↑(MUBSeedDifferential.seedDifferential u v)).ker = 2
MUBSeedLocalChart.actual_eventual_zero_set_chart (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  ∀ᶠ (theta : ↥MUBSeedDifferential.angleDomain) in nhds 0,
    MUBSeedDifferential.seedEquation u v theta = 0 ↔
      ∃ k,
        (0, k) ∈ (MUBSeedLocalChart.seedChart u v hu hv hunit).target ∧
          ↑(MUBSeedLocalChart.seedChart u v hu hv hunit).symm (0, k) = theta
MUBSunDiscriminant.actual_discriminant_slack (u : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u) :
  Complex.normSq (MUBSunDiscriminant.vandermonde u) =
    27 - 18 * MUBSunCubeGram.q u - MUBSunCubeGram.q u ^ 2 + 8 * (MUBSunCubeGram.gamma u ^ 3).re
MUBSunDiscriminant.actual_parameter_stronger_bound (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  MUBSunCubeGram.q u ≤ 6 * √3 - 9
MUBSunDiscriminant.actual_cube_rank_dichotomy (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  Matrix.rank (MUBSunCubeGram.entryCube (MUBSunCubeGram.blockMatrix u v)) = if MUBSunCubeGram.q u = 0 then 2 else 6
@[expose] def MUBSunDiscriminant.vandermonde : MUBSunCubeGram.Triple → ℂ :=
fun u =>
  (MUBUniformSubmersion.ratios u 0 - MUBUniformSubmersion.ratios u 1) *
      (MUBUniformSubmersion.ratios u 0 - MUBUniformSubmersion.ratios u 2) *
    (MUBUniformSubmersion.ratios u 1 - MUBUniformSubmersion.ratios u 2)
MUBUniformSubmersion.actual_coefficient_gram (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  MUBUniformSubmersion.coefficientMatrix u v * (MUBUniformSubmersion.coefficientMatrix u v).transpose =
    MUBUniformSubmersion.gramModel (MUBSunCubeGram.gamma u).re (MUBSunCubeGram.gamma u).im
MUBUniformSubmersion.actual_coefficient_characteristic_polynomial (u v : MUBSunCubeGram.Triple)
  (hu : MUBSunCubeGram.UnitTriple u) (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  (MUBUniformSubmersion.coefficientMatrix u v * (MUBUniformSubmersion.coefficientMatrix u v).transpose).charpoly =
    (Polynomial.X - Polynomial.C (3 - MUBSunCubeGram.q u)) * (Polynomial.X - Polynomial.C (3 + MUBSunCubeGram.q u / 3))
MUBUniformSubmersion.actual_uniform_lower_bound (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) (a b : ℝ) :
  3 / 2 * (a ^ 2 + b ^ 2) ≤
    ![a, b] ⬝ᵥ
      (MUBUniformSubmersion.coefficientMatrix u v * (MUBUniformSubmersion.coefficientMatrix u v).transpose).mulVec
        ![a, b]
MUBUniformSubmersion.coefficient_action_on_mean_zero (u v : MUBSunCubeGram.Triple) (theta phi : Fin 3 → ℝ)
  (htheta : ∑ j, theta j = 0) (hphi : ∑ j, phi j = 0) :
  (MUBUniformSubmersion.coefficientMatrix u v).mulVec ![theta 0, theta 1, theta 2, phi 0, phi 1, phi 2] =
    ![(Complex.I *
          (∑ j, MUBUniformSubmersion.ratios u j * ↑(theta j) + ∑ j, MUBUniformSubmersion.ratios v j * ↑(phi j))).re,
      (Complex.I *
          (∑ j, MUBUniformSubmersion.ratios u j * ↑(theta j) + ∑ j, MUBUniformSubmersion.ratios v j * ↑(phi j))).im]
MUBUniformSubmersion.actual_bounded_mean_zero_preimage (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1)
  (y : Fin 2 → ℝ) :
  ∃ x,
    MUBUniformSubmersion.MeanZeroPair x ∧
      (MUBUniformSubmersion.coefficientMatrix u v).mulVec x = y ∧ ∑ i, x i ^ 2 ≤ 2 / 3 * ∑ i, y i ^ 2
@[expose] def MUBUniformSubmersion.coefficientMatrix : MUBSunCubeGram.Triple →
  MUBSunCubeGram.Triple → Matrix (Fin 2) (Fin 6) ℝ :=
fun u v =>
  !![(MUBUniformSubmersion.projectedRatios u 0).re, (MUBUniformSubmersion.projectedRatios u 1).re,
      (MUBUniformSubmersion.projectedRatios u 2).re, (MUBUniformSubmersion.projectedRatios v 0).re,
      (MUBUniformSubmersion.projectedRatios v 1).re, (MUBUniformSubmersion.projectedRatios v 2).re;
    (MUBUniformSubmersion.projectedRatios u 0).im, (MUBUniformSubmersion.projectedRatios u 1).im,
      (MUBUniformSubmersion.projectedRatios u 2).im, (MUBUniformSubmersion.projectedRatios v 0).im,
      (MUBUniformSubmersion.projectedRatios v 1).im, (MUBUniformSubmersion.projectedRatios v 2).im]
@[expose] def MUBUniformSubmersion.MeanZeroPair : (Fin 6 → ℝ) → Prop :=
fun x => x 0 + x 1 + x 2 = 0 ∧ x 3 + x 4 + x 5 = 0
@[expose] def MUBUniformSubmersion.canonicalRightInverse : MUBSunCubeGram.Triple →
  MUBSunCubeGram.Triple → Matrix (Fin 6) (Fin 2) ℝ :=
fun u v =>
  (MUBUniformSubmersion.coefficientMatrix u v).transpose *
    (MUBUniformSubmersion.coefficientMatrix u v * (MUBUniformSubmersion.coefficientMatrix u v).transpose)⁻¹
MUBSunCubeGram.actual_cube_gram (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  Matrix.conjTranspose (MUBSunCubeGram.entryCube (MUBSunCubeGram.blockMatrix u v)) *
      MUBSunCubeGram.entryCube (MUBSunCubeGram.blockMatrix u v) =
    MUBSunCubeGram.correlationGram (6 - 6 * ↑(MUBSunCubeGram.q u))
MUBSunCubeGram.actual_parameter_range (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  0 ≤ MUBSunCubeGram.q u ∧ MUBSunCubeGram.q u ≤ 3 / 2
MUBSunCubeGram.actual_normalization_identity (C : MUBSunCubeGram.SixMatrix) :
  MUBSunCubeGram.normalizedDeficit (MUBSunCubeGram.entryCube C) =
    1 / 72 -
      ((Matrix.conjTranspose (MUBSunCubeGram.entryCube (MUBSunCubeGram.phaseNormalize C)) *
              MUBSunCubeGram.entryCube (MUBSunCubeGram.phaseNormalize C)) ^
            2).trace.re
MUBSunCubeGram.actual_residual_energy (u v : MUBSunCubeGram.Triple) (hu : MUBSunCubeGram.UnitTriple u)
  (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  MUBSunCubeGram.frobeniusSq (MUBSunCubeGram.residual (MUBSunCubeGram.entryCube (MUBSunCubeGram.blockMatrix u v))) =
    2592 * MUBSunCubeGram.q u * (3 - MUBSunCubeGram.q u ^ 2)
MUBSunCubeGram.actual_maximum_witness :
  MUBSunCubeGram.UnitTriple MUBSunCubeGram.witnessU ∧
    MUBSunCubeGram.UnitTriple MUBSunCubeGram.witnessV ∧
      Matrix.conjTranspose (MUBSunCubeGram.blockMatrix MUBSunCubeGram.witnessU MUBSunCubeGram.witnessV) *
            MUBSunCubeGram.blockMatrix MUBSunCubeGram.witnessU MUBSunCubeGram.witnessV =
          6 • 1 ∧
        MUBSunCubeGram.q MUBSunCubeGram.witnessU = 1
MUBSunCubeSpectrum.actual_cube_characteristic_polynomial (u v : MUBSunCubeGram.Triple)
  (hu : MUBSunCubeGram.UnitTriple u) (hv : MUBSunCubeGram.UnitTriple v)
  (hunit : Matrix.conjTranspose (MUBSunCubeGram.blockMatrix u v) * MUBSunCubeGram.blockMatrix u v = 6 • 1) :
  (Matrix.conjTranspose (MUBSunCubeGram.entryCube (MUBSunCubeGram.blockMatrix u v)) *
        MUBSunCubeGram.entryCube (MUBSunCubeGram.blockMatrix u v)).charpoly =
    (Polynomial.X - Polynomial.C (18 - 12 * ↑(MUBSunCubeGram.q u))) ^ 2 *
      (Polynomial.X - Polynomial.C (6 * ↑(MUBSunCubeGram.q u))) ^ 4
@[expose] def MUBSunCubeGram.blockMatrix : MUBSunCubeGram.Triple → MUBSunCubeGram.Triple → MUBSunCubeGram.SixMatrix :=
fun u v =>
  !![u 0, Complex.I * (starRingEnd ℂ) (v 0), u 1, Complex.I * (starRingEnd ℂ) (v 2), u 2,
      Complex.I * (starRingEnd ℂ) (v 1);
    Complex.I * v 0, (starRingEnd ℂ) (u 0), Complex.I * v 1, (starRingEnd ℂ) (u 2), Complex.I * v 2,
      (starRingEnd ℂ) (u 1);
    u 1, Complex.I * (starRingEnd ℂ) (v 2), u 2, Complex.I * (starRingEnd ℂ) (v 1), u 0,
      Complex.I * (starRingEnd ℂ) (v 0);
    Complex.I * v 1, (starRingEnd ℂ) (u 2), Complex.I * v 2, (starRingEnd ℂ) (u 1), Complex.I * v 0,
      (starRingEnd ℂ) (u 0);
    u 2, Complex.I * (starRingEnd ℂ) (v 1), u 0, Complex.I * (starRingEnd ℂ) (v 0), u 1,
      Complex.I * (starRingEnd ℂ) (v 2);
    Complex.I * v 2, (starRingEnd ℂ) (u 1), Complex.I * v 0, (starRingEnd ℂ) (u 0), Complex.I * v 1,
      (starRingEnd ℂ) (u 2)]
@[expose] def MUBSunCubeGram.UnitTriple : MUBSunCubeGram.Triple → Prop :=
fun u => ∀ (j : Fin 3), u j * (starRingEnd ℂ) (u j) = 1
@[expose] def MUBSeedGluing.step : MUBSeedGluing.Edge → MUBSeedGluing.Face → MUBSeedGluing.Face :=
fun e f =>
  match ↑e with
  | 0 => (f.1, Equiv.swap 1 2 * f.2)
  | 1 => (Equiv.swap 0 1 * f.1, f.2)
  | 2 => (f.1, Equiv.swap 0 2 * f.2)
  | 3 => (Equiv.swap 1 2 * f.1, f.2)
  | 4 => (f.1, Equiv.swap 0 1 * f.2)
  | x => (Equiv.swap 0 2 * f.1, f.2)
MUBSeedGluing.actual_cell_counts : MUBSeedGluing.edgeCount = 108 ∧ MUBSeedGluing.vertexCount = 54
MUBSeedGluing.gluing_graph_connected (f g : MUBSeedGluing.Face) : Relation.ReflTransGen MUBSeedGluing.adjacent f g
