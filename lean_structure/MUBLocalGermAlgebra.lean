module
public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import Mathlib.LinearAlgebra.Matrix.Notation
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.RingTheory.MvPowerSeries.Inverse
public import Mathlib.Analysis.SpecialFunctions.Sqrt
public import Mathlib.Tactic.Ring
public import Mathlib.Tactic.Linarith
@[expose] public section
noncomputable section
namespace MUBLocalGermAlgebra
open Matrix

/-- Every coordinate of an actual coefficient-matrix combination lies in the
ideal generated by the original coordinates. -/
theorem span_mulVec_le {R n : Type*} [CommRing R] [Fintype n]
    (Q : Matrix n n R) (g : n → R) :
    Ideal.span (Set.range (Q *ᵥ g)) ≤ Ideal.span (Set.range g) := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  exact Submodule.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩))

/-- An invertible coefficient matrix preserves the generated ideal. No ideal
equality is assumed; both inclusions are derived from the inverse matrix. -/
theorem span_mulVec_eq_of_unit_det {R n : Type*} [CommRing R] [Fintype n] [DecidableEq n]
    (Q : Matrix n n R) (g : n → R) (hQ : IsUnit Q.det) :
    Ideal.span (Set.range (Q *ᵥ g)) = Ideal.span (Set.range g) := by
  apply le_antisymm (span_mulVec_le Q g)
  have h := span_mulVec_le Q⁻¹ (Q *ᵥ g)
  simpa only [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul _ hQ, Matrix.one_mulVec] using h

/-- The explicit mixed Hessian coefficient matrix from the indirect-product
crossing. Its entries are verified here; its derivative origin is external. -/
def mixedMatrix (r : ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![1,-r/3,-1,r/3;
     1,-r/3,1+r,2*r/3;
     1,-1+2*r/3,0,0;
     1,-1+2*r/3,-2+r,-1+2*r/3]

theorem mixed_determinant (r : ℝ) (hr : r^2 = 3) :
    (mixedMatrix r).det = -4+2*r := by
  rw [Matrix.det_succ_row_zero]
  simp only [Matrix.det_fin_three, Matrix.submatrix_apply]
  norm_num [mixedMatrix, Fin.sum_univ_succ, Fin.succAbove]
  have hr3 : r^3 = 3*r := by nlinarith [congrArg (fun x : ℝ => x*r) hr]
  ring_nf
  rw [hr, hr3]
  ring

theorem actual_mixed_determinant_nonzero :
    (mixedMatrix (Real.sqrt 3)).det ≠ 0 := by
  have hr := Real.sq_sqrt (show (0 : ℝ) ≤ 3 by norm_num)
  rw [mixed_determinant _ hr]
  intro h
  nlinarith

/-- Formal power-series coefficients are invertible when their constant
coefficient matrix is the displayed actual nonsingular matrix. -/
theorem powerSeries_unit_det {σ : Type*}
    (Q : Matrix (Fin 4) (Fin 4) (MvPowerSeries σ ℝ))
    (hQ : Q.map MvPowerSeries.constantCoeff = mixedMatrix (Real.sqrt 3)) :
    IsUnit Q.det := by
  rw [MvPowerSeries.isUnit_iff_constantCoeff]
  rw [RingHom.map_det]
  change IsUnit (Q.map MvPowerSeries.constantCoeff).det
  rw [hQ]
  exact isUnit_iff_ne_zero.mpr actual_mixed_determinant_nonzero

theorem powerSeries_generators_eq {σ : Type*}
    (Q : Matrix (Fin 4) (Fin 4) (MvPowerSeries σ ℝ))
    (g : Fin 4 → MvPowerSeries σ ℝ)
    (hQ : Q.map MvPowerSeries.constantCoeff = mixedMatrix (Real.sqrt 3)) :
    Ideal.span (Set.range (Q *ᵥ g)) = Ideal.span (Set.range g) :=
  span_mulVec_eq_of_unit_det Q g (powerSeries_unit_det Q hQ)

end MUBLocalGermAlgebra
